# Flask
FLASK_SECRET_KEY=change-me-to-a-random-value
# Set to "production" on the deployed (Azure) instance: enables secure session cookies
APP_ENV=development

# --- IU Login (OIDC) -- values come from the IU Login team after they register the app.
# The discovery URL is the issuer's /.well-known/openid-configuration endpoint.
# (If IU uses Microsoft Entra ID this looks like:
#  https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration)
IU_OIDC_DISCOVERY_URL=
IU_OIDC_CLIENT_ID=
IU_OIDC_CLIENT_SECRET=
# Must exactly match the redirect URI registered with the IU Login team.
IU_OIDC_REDIRECT_URI=http://localhost:8000/auth/iu/callback

# --- Canvas OAuth2 (Developer Key) -- values come from UITS (Erik) via Secure Share.
# NOTE: the Dev Key currently lives on the Canvas TEST instance; confirm the exact
# domain with UITS when receiving credentials (production is iu.instructure.com).
CANVAS_BASE_URL=https://iu.instructure.com
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:8000/oauth/callback
# Space-separated Canvas API scopes, if the Developer Key enforces scopes.
CANVAS_OAUTH_SCOPES=

# --- ReaLLM
REALLM_API_KEY=
REALLM_URL=
REALLM_MODEL_NAME=

# --- App data
DATABASE_PATH=instance/autograder.sqlite3
