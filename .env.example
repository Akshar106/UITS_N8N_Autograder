# Flask
FLASK_SECRET_KEY=change-me-to-a-random-value

# Canvas OAuth2 (Developer Key) -- values come from IU UITS once the key is created
# Confirm the exact Canvas domain for IU with UITS (commonly https://iu.instructure.com)
CANVAS_BASE_URL=https://iu.instructure.com
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:8000/oauth/callback
# Space-separated Canvas API scopes, if the Developer Key enforces scopes.
# Leave blank if the key is not scope-enforced (token then inherits the user's full role permissions).
CANVAS_OAUTH_SCOPES=

# ReaLLM
REALLM_API_KEY=
REALLM_URL=
REALLM_MODEL_NAME=

# App data
DATABASE_PATH=instance/autograder.sqlite3
